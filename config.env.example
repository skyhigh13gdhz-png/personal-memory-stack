# 复制到 /etc/personal-memory-stack.env 后必须 chmod 600。

# 可选：新服务器上预先放置的 Codex auth.json。留空时由 memory-server-infra 进入自身授权流程。
CODEX_AUTH_SOURCE_FILE=

# 推荐把 Cloudflare remotely-managed Tunnel token 单独放入 root-only 文件。
CLOUDFLARE_TUNNEL_TOKEN_FILE=/root/.secrets/personal-memory-tunnel.token

# 已在 Cloudflare Dashboard 配置的公网 Hostname；Service 必须是 http://127.0.0.1:8000，Path 留空。
MEMORY_MCP_PUBLIC_HOST=memory.skyhighmonica.fyi

# 仅在明确需要替换现有 connector token 时设为 1。
CLOUDFLARE_REINSTALL_SERVICE=0

# 默认 Cloudflare 是完整部署的必需阶段；只有明确只做本机链路时才设为 1。
PERSONAL_MEMORY_ALLOW_NO_CLOUDFLARE=0

# 中国大陆服务器默认复用 Xray HTTP 入站。
XRAY_HTTP_PROXY=http://127.0.0.1:10809
