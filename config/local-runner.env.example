# 本机增量运行器配置模板
#
# 复制为独立文件并 chmod 600，例如 ~/.config/personal-memory/incremental.env。
# LaunchAgent plist 只保存这个文件的位置，不保存其中的任何值。
# 不要把填好的文件、Token 或 Vault 内容提交到 Git。
#
# 优先级：命令行参数 > 本文件 > 进程环境 > 内置默认值。
# 本文件同时配置运行器自身和它调用的子脚本，两者看到的必须是同一个 Vault。

# Vault 根目录；留空时运行器使用仓库默认值
PERSONAL_MEMORY_VAULT_DIR=""

# 原始记录投影、日报和状态页目录；留空时按 Vault 内的既定布局推导
PERSONAL_MEMORY_RAW_DIR=""
PERSONAL_MEMORY_DAILY_DIR=""
PERSONAL_MEMORY_STATUS_OUTPUT=""

# 原始投影来源，与 sync_obsidian_vault.sh 一致
PERSONAL_MEMORY_SERVER=""
PERSONAL_MEMORY_SPEAKER="liangzai"

# 每轮最多生成几天日报。所有早于今天的缺失日期都会进入待补队列，
# 昨天优先，其余从新到旧排队，未处理完的下轮继续，不会永久漏补。
PERSONAL_MEMORY_MAX_DAILY_DAYS_PER_RUN="3"

# 每个阶段的尝试次数上限、重试间隔（秒）和单次超时（秒）
PERSONAL_MEMORY_MAX_ATTEMPTS="3"
PERSONAL_MEMORY_RETRY_DELAY="5.0"
PERSONAL_MEMORY_STAGE_TIMEOUT="1800"

# 运行状态与结构化日志位置
PERSONAL_MEMORY_RUNNER_STATE_DIR=""
PERSONAL_MEMORY_RUNNER_LOG_FILE=""
